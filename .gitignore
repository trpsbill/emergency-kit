# kiwix binaries and ZIM archives (multi-GB; see README for download URLs)
kiwix/

# generated embedding index
index.npz
*.npz

# reference documents are downloaded via setup.sh, not committed
# (see docs/SOURCES.md); only SOURCES.md itself is tracked
docs/*
!docs/SOURCES.md

# machine-specific config
.env

# python
__pycache__/
.venv/
venv/

# offline map extracts, pmtiles CLI, and vendored map viewer libraries
# (all downloaded via setup.sh)
maps/
static/vendor/

# runtime state and logs
run/
*.log

# generated test transcripts (summary.md is kept)
results/q*.txt
results/step*/

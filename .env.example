# Machine-specific overrides. Copy to .env and edit; .env is gitignored.
# All values are optional — defaults assume everything runs on localhost.

# Extra base URLs to try for LM Studio / kiwix, comma-separated, tried after
# localhost. Needed e.g. when developing under WSL2 with LM Studio on the
# Windows host (use the gateway IP from `ip route show default`).
#LMSTUDIO_EXTRA_URLS=http://192.168.x.x:1234/v1
#KIWIX_EXTRA_URLS=

# Model identifiers as served by the OpenAI-compatible endpoint.
#CHAT_MODEL=qwen3.5-4b
#EMBED_MODEL=text-embedding-nomic-embed-text-v1.5@f16

# Kiwix base URL as seen from the *browser* (used for citation links).
#KIWIX_PUBLIC_URL=http://localhost:8080

# Ports used by start.sh.
#APP_PORT=8000
#KIWIX_PORT=8080

# Path to the kiwix-serve binary (start.sh).
#KIWIX_BIN=./kiwix/kiwix-tools_linux-x86_64-3.8.1/kiwix-serve
